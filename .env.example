# Vercel 的 Neon 集成会自动提供此变量。
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# 在 Vercel 项目的 Storage 中创建 Blob 后自动提供。
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_example

# 可选：用于社交分享卡片的绝对地址。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 高德地图 Web 端（JS API）Key 与安全密钥，用于浏览器地图渲染。
NEXT_PUBLIC_AMAP_JS_KEY=your_amap_javascript_key
NEXT_PUBLIC_AMAP_SECURITY_CODE=your_amap_security_code

# 高德地图 Web 服务 Key，仅在服务端用于地点解析与路径规划。
AMAP_WEB_SERVICE_KEY=your_amap_web_service_key
